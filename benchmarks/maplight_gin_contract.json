    "input_policy": "Parse every exact raw TDC string with pinned RDKit as MapLight does; MolFeat then converts the parsed molecule to its SMILES input. Cache only by exact raw UTF-8 SHA-256.",
    "failed_row_policy": "stop on parse failure, missing embedding, wrong dimension, or any non-finite value",
    "row_policy": "retain every official row and expand exact-raw cached embeddings back in frozen feature_rows.csv order"
  },
  "operations": {
    "weight_freeze": "download exactly one metadata file and one model file, verify bytes, retain no alternate weight",
    "fixture_parity": "one pinned MapLight source worker and two direct MolFeat workers in fresh CPU processes must produce byte-identical 8x300 NPY v1.0 arrays",
    "real_builds": 2,
    "real_build_independence": "each build featurizes all 15399 exact raw inputs in a fresh process and may not reuse another build's array or cache",
    "repeat_gate": "feature_rows.csv and gin.npy must be byte-identical between builds",
    "multi_raw_audit": "report exact equality and maximum absolute difference for every standardized hash associated with more than one raw form"
  },
